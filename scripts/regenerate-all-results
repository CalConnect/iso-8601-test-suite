#!/usr/bin/env ruby
# frozen_string_literal: true

# Regenerate results for all adapters defined in ADAPTER_DEFS.
# Usage: ruby scripts/regenerate-all-results [--only ID1,ID2] [--skip ID1,ID2]

require_relative "../lib/test_suite"
require "optparse"
require "fileutils"

REPO_ROOT = File.expand_path(File.join(__dir__, ".."))
Dir.chdir(REPO_ROOT)

options = {}
OptionParser.new do |opts|
  opts.banner = "Usage: ruby scripts/regenerate-all-results [options]"
  opts.on("--only IDS", "Comma-separated adapter IDs to run") { |v| options[:only] = v.split(",") }
  opts.on("--skip IDS", "Comma-separated adapter IDs to skip") { |v| options[:skip] = v.split(",") }
  opts.on("--quiet", "Suppress per-test output") { options[:quiet] = true }
  opts.on("--help", "Show help") { puts opts; exit 0 }
end.parse!

defs = CapabilityMatrix::ADAPTER_DEFS
only = options[:only]
skip = options[:skip] || []

to_run = defs.select { |d| only ? only.include?(d[:id]) : true }
to_run = to_run.reject { |d| skip.include?(d[:id]) }

puts "Regenerating #{to_run.length} adapter results..."
puts ""

results_dir = File.join(REPO_ROOT, "results")
FileUtils.mkdir_p(results_dir)

success = []
failed = []

to_run.each_with_index do |d, i|
  id = d[:id]
  adapter_spec = d[:adapter]
  output = File.join(results_dir, "#{id}.yaml")

  print "[#{i+1}/#{to_run.length}] #{id.ljust(20)} ... "
  $stdout.flush

  start = Time.now
  prior_mtime = File.exist?(output) ? File.mtime(output) : nil
  cmd = ["ruby", "scripts/run-tests", "--adapter", adapter_spec, "-o", output]
  cmd << "--quiet" if options[:quiet]
  stderr_file = File.join(results_dir, ".#{id}.regenerate.log")
  system(*cmd, out: "/dev/null", err: stderr_file)
  elapsed = Time.now - start

  # run-tests exits 1 whenever any test fails — that's expected for most
  # adapters and does NOT indicate the adapter is broken. The real signals
  # are: (1) the output file was rewritten this run (mtime advanced), and
  # (2) the file is non-trivially sized. A broken adapter (LoadError,
  # crash, can't start) leaves the stale file untouched.
  fresh = File.exist?(output) && (prior_mtime.nil? || File.mtime(output) > prior_mtime)
  nontrivial = File.exist?(output) && File.size(output) > 100

  if fresh && nontrivial
    puts sprintf("done (%.1fs)", elapsed)
    success << id
  else
    reason = !fresh ? "no output written (adapter likely broken)" : "output too small"
    tail = File.exist?(stderr_file) ? File.read(stderr_file) : ""
    tail_lines = tail.lines.last(5).map { |l| "    | #{l.chomp}" }.join("\n")
    puts sprintf("FAILED (%.1fs) — %s\n%s", elapsed, reason, tail_lines)
    failed << id
  end
  File.delete(stderr_file) if File.exist?(stderr_file)
end

puts ""
puts "Success: #{success.length}/#{to_run.length}"
puts "Failed:  #{failed.length}" if failed.any?
failed.each { |id| puts "  - #{id}" }

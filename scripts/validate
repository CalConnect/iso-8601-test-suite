#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative '../lib/test_suite'
require 'yaml'
require 'optparse'
require 'set'

REPO_ROOT = File.expand_path(File.join(__dir__, ".."))
Dir.chdir(REPO_ROOT)

Phase = Struct.new(:name, :type, :subtitle, :handler, keyword_init: true)

class Runner
  def initialize(options = {})
    @quiet   = options[:quiet]
    @verbose = options[:verbose]
    @stats   = Stats.new
    @store   = YamlStore.new
    @index   = SuiteIndex.new(@store)
    @vocab   = ComponentVocabulary.new(@store)
  end

  def run
    print_banner
    all_files = collect_files

    @index.load_all

    phases = build_phases(all_files)
    phases.each do |phase|
      print_section(phase.type, phase.name, phase.subtitle)
      phase.handler.call
    end

    print_summary
    @stats.ok? ? 0 : 1
  end

  private

  def build_phases(all_files)
    [
      Phase.new(name: "YAML Syntax", type: :syntax,
        subtitle: "Parsing #{all_files.length} files",
        handler: -> { phase_syntax(all_files) }),

      Phase.new(name: "Schema References", type: :schema,
        subtitle: "Verifying $schema headers",
        handler: -> { phase_schema_refs(all_files) }),

      Phase.new(name: "Schema Validation", type: :schema,
        subtitle: "Validating files against YAML Schema definitions",
        handler: -> { phase_schema_validation(all_files) }),

      Phase.new(name: "Requirements Classes", type: :requirements,
        subtitle: "Indexing requirements",
        handler: -> { phase_requirements }),

      Phase.new(name: "Conformance Classes", type: :tests,
        subtitle: "Indexing conformance tests",
        handler: -> { phase_tests }),

      Phase.new(name: "Requirements Coverage", type: :coverage,
        subtitle: "Checking test-referenced requirements",
        handler: -> { phase_coverage }),

      Phase.new(name: "Test Requirement References", type: :test_reqs,
        subtitle: "Checking tests reference existing requirements",
        handler: -> { phase_test_req_references }),

      Phase.new(name: "Profile References", type: :profiles,
        subtitle: "Checking profile conformance class refs",
        handler: -> { phase_profiles }),

      Phase.new(name: "Result Files", type: :results,
        subtitle: "Cross-referencing implementation results",
        handler: -> { phase_results }),

      Phase.new(name: "Dependency Graph", type: :dag,
        subtitle: "Checking for cycles",
        handler: -> { phase_dag }),

      Phase.new(name: "Source Consistency", type: :source_consistency,
        subtitle: "Checking req-class / conf-class source agreement",
        handler: -> { phase_source_consistency }),

      Phase.new(name: "Source URN Format", type: :urn_format,
        subtitle: "Validating RFC 5141 URN syntax",
        handler: -> { phase_urn_format }),

      Phase.new(name: "Suite Statistics", type: :statistics,
        subtitle: "Computing dynamic counts",
        handler: -> { phase_statistics }),

      Phase.new(name: "Pattern Coverage", type: :patterns,
        subtitle: "Checking format requirements have patterns",
        handler: -> { phase_pattern_coverage }),

      Phase.new(name: "Component Validity", type: :components,
        subtitle: "Checking expect.components keys",
        handler: -> { phase_component_validity }),

      Phase.new(name: "Test ID Naming", type: :naming,
        subtitle: "Validating test ID naming convention",
        handler: -> { phase_test_id_naming })
    ]
  end

  def phase_syntax(files)
    files.each { |f| @stats.file! }
    ok = files.count { |f| result = @store.load(f); result.success? }
    errors = files.length - ok
    if errors.zero?
      print_ok("All #{Term.bold(ok)} files parse correctly")
    else
      files.each do |f|
        result = @store.load(f)
        @stats.error(f, "YAML parse error: #{result.error_message}") if result.failure?
      end
      print_fail("#{ok}/#{files.length} files parsed successfully")
    end
  end

  def phase_schema_refs(files)
    missing = files.reject { |f| f.start_with?("schema/") || @store.schema_ref(f) }
    if missing.empty?
      print_ok("All #{Term.bold(files.length)} data files have $schema references")
    else
      missing.each { |f| print_warn("#{Term.cyan(f)}: missing $schema reference") }
    end
  end

  def phase_schema_validation(files)
    validator = SchemaValidator.new(@stats, @store)
    validated = 0
    before = @stats.error_count_snapshot

    files.each do |f|
      next if f.start_with?("schema/")
      next if File.basename(f) == "TEMPLATE.yaml"
      validator.validate_file(f)
      validated += 1
    end

    new_errors = @stats.error_count_snapshot - before
    if new_errors.zero?
      print_ok("#{Term.bold(validated)} files validated against their schemas")
    else
      print_fail("#{new_errors} schema validation error(s) in #{validated} files")
    end
  end

  def phase_requirements
    count = @index.req_ids.length
    classes = @index.req_class_ids.length
    print_counter(classes, "classes", count, "requirements")
  end

  def phase_tests
    count = @index.conf_test_ids.length
    classes = @index.bare_conf_class_ids.length
    print_counter(classes, "classes", count, "tests")
  end

  def phase_coverage
    referenced = @index.test_reqs.values.flatten.to_set
    all_reqs = @index.all_req_ids
    unreferenced = all_reqs - referenced.to_a
    unreferenced.each do |r|
      source = @index.req_ids[r] || @index.profile_req_ids[r]
      @stats.warn(source, "#{r}: not referenced by any test")
    end
    if unreferenced.empty?
      print_ok("All #{Term.bold(all_reqs.length)} requirements referenced by tests")
    end
  end

  def phase_test_req_references
    checked, bad = SuiteValidations.check_test_req_references(@index, @stats)
    if bad.zero?
      print_ok("All #{Term.bold(checked)} test requirement references resolve")
    else
      print_fail("#{bad} test reference(s) to undefined requirements")
    end
  end

  def phase_profiles
    @store.files_in("profiles/**/*.yaml").each do |f|
      next if File.basename(f) == "TEMPLATE.yaml"
      result = @store.load(f)
      next if result.failure?

      data = result.data
      before = @stats.error_count_snapshot

      (data["conformance_classes"] || []).each do |cc|
        unless @index.conf_class_ids.key?(cc)
          @stats.error(f, "references unknown conformance class '#{cc}'")
        end
      end

      (data["additional_tests"] || []).each do |t|
        tid = t["id"]
        (t["requirements"] || []).each do |r|
          unless @index.req_ids.key?(r) || @index.profile_req_ids.key?(r)
            @stats.error(f, "test #{tid}: references undefined requirement '#{r}' (not in requirements/ or profile additional_requirements)")
          end
        end
        if @index.conf_test_ids.key?(tid) && @index.conf_test_ids[tid] != f
          prev = @index.conf_test_ids[tid]
          @stats.error(f, "duplicate test ID '#{tid}' (also in #{prev})")
        end
      end

      errors = @stats.error_count_snapshot - before
      tc_count = (data["traceability"] || []).length
      test_count = (data["additional_tests"] || []).length
      if errors.zero?
        print_ok("#{Term.cyan(File.basename(f))} — #{tc_count} traceability classes, #{test_count} additional tests")
      else
        print_fail("#{Term.cyan(File.basename(f))} — #{errors} error(s)")
      end
    end
  end

  def phase_results
    @store.files_in("results/**/*.yaml")
      .reject { |f| File.basename(f) == "TEMPLATE.yaml" }
      .each do |f|
        result = @store.load(f)
        next if result.failure?

        data = result.data
        impl = data.dig("implementation", "name") || File.basename(f)
        total = 0
        before = @stats.error_count_snapshot

        (data["conformance_class_results"] || []).each do |cc|
          cc_ref = cc["conformance_class"]
          @stats.error(f, "references unknown conformance class '#{cc_ref}'") unless @index.conf_class_ids.key?(cc_ref)
          (cc["test_results"] || []).each do |tr|
            total += 1
            @stats.error(f, "references undefined test '#{tr['test']}'") unless @index.conf_test_ids.key?(tr["test"])
          end
        end

        (data["profile_results"] || []).each do |pr|
          (pr["test_results"] || []).each do |tr|
            total += 1
            @stats.error(f, "references undefined profile test '#{tr['test']}'") unless @index.conf_test_ids.key?(tr["test"])
          end
        end

        errors = @stats.error_count_snapshot - before
        if errors.zero?
          print_ok("#{Term.cyan(File.basename(f))} — #{Term.bold(impl)} (#{total} tests)")
        else
          print_fail("#{Term.cyan(File.basename(f))} — #{errors} error(s)")
        end
      end
  end

  def phase_dag
    cycles = GraphUtil.detect_cycles(@index.dependencies)
    cycles.each do |cycle|
      cycle_str = cycle.map { |n| Term.bmag(n) }.join(" #{Term.dim("→")} ")
      @stats.error("dependency-graph", "cycle detected: #{cycle_str}")
    end

    print_ok("No cycles in #{Term.bold(@index.dependencies.length)} requirements class dependencies") if cycles.empty?
  end

  def phase_source_consistency
    checked, mismatches = SuiteValidations.check_source_consistency(@index, @store, @stats)
    print_ok("#{Term.bold(checked)} conformance classes have consistent sources") if mismatches.zero?
  end

  def phase_urn_format
    checked, bad = SuiteValidations.check_urn_format(@index.source_map, @stats)
    print_ok("#{Term.bold(checked)} source references have valid format") if bad.zero?
  end

  def phase_statistics
    total_reqs = @index.all_req_ids.length
    total_tests = @index.total_test_count
    total_profiles = @index.profile_ids.length
    req_class_count = @index.req_class_ids.length
    print_info("#{Term.bold(total_reqs)} requirements (#{@index.req_ids.length} in classes + #{@index.profile_req_ids.length} in profiles)")
    print_info("#{Term.bold(total_tests)} conformance tests")
    print_info("#{Term.bold(req_class_count)} requirements classes")
    print_info("#{Term.bold(total_profiles)} profiles")
    print_ok("Statistics computed dynamically from file contents")
  end

  def phase_pattern_coverage
    total_format, missing = SuiteValidations.check_pattern_coverage(@store, @stats)
    print_ok("All #{Term.bold(total_format)} format requirements have pattern fields") if missing.zero?
  end

  def phase_component_validity
    checked = 0
    (@store.files_in("tests/**/*.yaml") + @store.files_in("profiles/**/*.yaml")).each do |f|
      result = @store.load(f)
      next if result.failure?
      data = result.data
      tests = data["tests"] || data["additional_tests"] || []
      tests.each do |t|
        components = t.dig("expect", "components")
        next unless components
        checked += 1
        SuiteValidations.check_component_keys(@vocab, @stats, f, t["id"], components)
      end
    end
    print_ok("#{Term.bold(checked)} test component sets validated")
  end

  def phase_test_id_naming
    checked, bad = SuiteValidations.check_test_id_naming(@index.conf_test_ids, @stats)
    print_ok("#{Term.bold(checked)} test IDs follow naming convention") if bad.zero?
  end

  def collect_files
    @store.files_in("{schema,suite,requirements,tests,profiles,results}/**/*.yaml")
  end

  # ── Output ──

  def print_banner
    return if @quiet
    puts ""
    puts Term.double_hr
    puts "#{Term.bold(Term.white("  ISO 8601 Test Suite"))} #{Term.dim("— Validation Report")}"
    puts Term.double_hr
    puts ""
  end

  def print_section(type, title, subtitle = nil)
    return if @quiet
    icon = Term.section_icon(type)
    label = Term.bold(Term.white(title))
    sub = subtitle ? Term.dim("  #{subtitle}") : ""
    puts " #{icon} #{label}#{sub}"
    puts " #{Term.hr("┄", 56)}"
  end

  def print_ok(msg)
    puts " #{Term.ok_icon}  #{msg}" unless @quiet
    @stats.pass!
  end

  def print_fail(msg)
    puts " #{Term.fail_icon}  #{msg}"
  end

  def print_warn(msg)
    puts " #{Term.warn_icon}  #{msg}"
  end

  def print_info(msg)
    puts " #{Term.info_icon}  #{msg}" if !@quiet
  end

  def print_counter(*args)
    return if @quiet
    parts = args.each_slice(2).map { |count, label| "#{Term.bold(count)} #{label}" }
    puts " #{Term.info_icon}  #{parts.join(", ")}"
  end

  def print_summary
    if @quiet && @stats.ok?
      puts Term.bgreen("All checks passed.")
      return
    end

    width = 60
    puts ""
    puts " #{Term.hr("─", width)}"

    if @stats.errors.any?
      puts " #{Term.bred(Term.bold("  Errors (#{@stats.errors.length})"))}"
      @stats.errors.each do |e|
        path_part = e[:path] ? "#{Term.cyan(e[:path])}: " : ""
        puts "   #{Term.bred("•")} #{path_part}#{e[:msg]}"
      end
    end

    if @stats.warnings.any? && !@quiet
      puts ""
      puts " #{Term.byellow(Term.bold("  Warnings (#{@stats.warnings.length})"))}"
      @stats.warnings.each do |w|
        path_part = w[:path] ? "#{Term.cyan(w[:path])}: " : ""
        puts "   #{Term.byellow("•")} #{path_part}#{w[:msg]}"
      end
    end

    puts ""
    puts " #{Term.hr("─", width)}"

    if @stats.ok?
      puts " #{Term.badge("ALL PASSED")} #{Term.bgreen(Term.bold("All checks passed"))}"
    else
      puts " #{Term.badge("FAILED", Term::BG_RED)} #{Term.bred(Term.bold("#{@stats.errors.length} error(s), #{@stats.warnings.length} warning(s)"))}"
    end
    puts " #{Term.dim("  #{@stats.total_files} files checked")}"

    puts ""
    puts Term.double_hr
    puts ""
  end
end

options = {}
parser = OptionParser.new do |opts|
  opts.banner = "Usage: ruby validate [options]"

  opts.on("-q", "--quiet", "Only show errors and warnings") do
    options[:quiet] = true
  end

  opts.on("-v", "--verbose", "Show every individual check") do
    options[:verbose] = true
  end

  opts.on("-h", "--help", "Show this help") do
    puts opts
    exit 0
  end
end
parser.parse!

exit Runner.new(options).run

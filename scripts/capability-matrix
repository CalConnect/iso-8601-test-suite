#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative '../lib/test_suite'
require 'optparse'
require 'fileutils'
require 'json'

REPO_ROOT = File.expand_path(File.join(__dir__, ".."))
Dir.chdir(REPO_ROOT)

options = {}
parser = OptionParser.new do |opts|
  opts.banner = "Usage: ruby scripts/capability-matrix [options]"
  opts.on("-o", "--output DIR", "Output directory for summary.json and detail.json") { |f| options[:output] = f }
  opts.on("-q", "--quiet", "Suppress progress") { options[:quiet] = true }
  opts.on("-h", "--help", "Show help") { puts opts; exit 0 }
end
parser.parse!

unless options[:quiet]
  $stderr.puts ""
  $stderr.puts Term.bold("  ISO 8601 Capability Matrix Generator")
  $stderr.puts ""
end

store = YamlStore.new
index = SuiteIndex.new(store)
suite = TestSuiteLoader.new(store, index)
matrix_gen = CapabilityMatrix.new(store, index, suite)

on_progress = if options[:quiet]
  nil
else
  lambda do |event, *args|
    case event
    when :adapter_failed
      name, msg = args
      $stderr.puts "  #{Term.red("FAILED")} to load #{name}: #{msg}"
    when :requirement
      req_id, req, adapters, req_entry = args
      short_id = req_id.sub("req:", "")
      section = (req&.section || "?").to_s
      adapter_summary = adapters.map do |adefn|
        caps = req_entry[:tests][adefn.id] || {}
        statuses = caps.values.map { |c| c[:status] }
        if statuses.empty?
          "  "
        elsif statuses.all?("pass")
          Term.green("✓")
        elsif statuses.all?("fail")
          Term.red("✗")
        else
          Term.byellow("~")
        end
      end
      $stderr.puts "  #{section.ljust(12)} #{short_id.ljust(35)} #{adapter_summary.join("  ")}"
    end
  end
end

matrix = matrix_gen.generate(on_progress: on_progress)

base = options[:output] || File.join(REPO_ROOT, "site", "public")
summary_path = File.join(base, "summary.json")
detail_path = File.join(base, "detail.json")

MatrixOutput.write_summary(matrix, summary_path)
MatrixOutput.write_detail(matrix, detail_path)

unless options[:quiet]
  total = matrix[:requirements].length
  libs = matrix[:libraries].length
  prof_count = matrix[:profiles].length
  summary_kb = (File.size(summary_path) / 1024.0).round(1)
  detail_kb = (File.size(detail_path) / 1024.0).round(1)
  $stderr.puts ""
  $stderr.puts "  #{Term.green("Done")} — #{Term.bold(total)} requirements × #{Term.bold(libs)} libraries × #{Term.bold(prof_count)} profiles"
  $stderr.puts "  Summary: #{Term.cyan(summary_path)} (#{summary_kb} KB)"
  $stderr.puts "  Detail:  #{Term.cyan(detail_path)} (#{detail_kb} KB)"
  $stderr.puts ""
end

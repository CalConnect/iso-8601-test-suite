#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative '../lib/test_suite'

require 'yaml'
require 'optparse'
require 'fileutils'

REPO_ROOT = File.expand_path(File.join(__dir__, ".."))
Dir.chdir(REPO_ROOT)

class Runner
  def initialize(options = {})
    @adapter_name = options[:adapter] || "ruby-date"
    @profile = options[:profile]
    @class_filter = options[:class_filter]
    @output = options[:output]
    @verbose = options[:verbose]
    @quiet = options[:quiet]
    @list = options[:list]
  end

  def run
    store = YamlStore.new
    index = SuiteIndex.new(store)
    suite = TestSuiteLoader.new(store, index)

    if @list
      list_available(suite, index)
      return 0
    end

    adapter = begin
      AdapterLoader.load(@adapter_name)
    rescue AdapterNotFoundError => e
      $stderr.puts Term.red("ERROR: #{e.message}")
      return 1
    end

    tests, label = select_tests(suite, index)

    if tests.empty?
      $stderr.puts Term.red("No tests found for: #{@profile || @class_filter || 'unknown'}")
      return 1
    end

    puts ""
    puts Term.bold("  ISO 8601 Test Runner")
    puts Term.dim("  Adapter: #{adapter.name} (#{adapter.language} #{adapter.version})")
    puts Term.dim("  Tests:   #{tests.length} | #{label}")
    puts ""

    results = []
    counts = { pass: 0, fail: 0, error: 0, not_supported: 0 }
    declared = adapter.respond_to?(:declared_conformance_classes) ? adapter.declared_conformance_classes : nil

    tests.each do |test|
      tid = test["id"]
      desc = test["description"] || ""

      if declared && !declared.empty?
        type, id = infer_class(tid, index)
        if type == :conformance_class && !declared.include?(id)
          results << { "test" => tid, "description" => desc, "result" => "not-supported", "notes" => "Conformance class not declared by implementation" }
          counts[:not_supported] += 1
          unless @quiet
            puts "  #{Term.dim("  N/S ")}  #{Term.cyan(tid)} #{Term.dim("not declared: #{id}")}"
          end
          next
        end
      end

      result = TestTypeHandlers.run(adapter, test)
      result["test"] = tid
      result["description"] = desc
      results << result

      status = result["result"]
      case status
      when "pass"          then counts[:pass] += 1
      when "fail"          then counts[:fail] += 1
      when "error"         then counts[:error] += 1
      when "not-supported" then counts[:not_supported] += 1
      end

      unless @quiet
        icon = case status
               when "pass"          then Term.green("  PASS")
               when "fail"          then Term.bred("  FAIL")
               when "error"         then Term.red("  ERR ")
               when "not-supported" then Term.dim("  N/S ")
               end
        line = "  #{icon}  #{Term.cyan(tid)}"
        line << " #{Term.dim(desc[0, 60])}" if @verbose
        line << " #{Term.dim(result["notes"])}" if result["notes"] && status != "pass"
        puts line
      end
    end

    total = tests.length
    puts ""
    puts Term.dim("  #{'─' * 50}")
    puts "  #{Term.bold(total)} tests: " \
         "#{Term.green(counts[:pass])} passed, " \
         "#{Term.red(counts[:fail])} failed, " \
         "#{Term.red(counts[:error])} errors, " \
         "#{Term.dim(counts[:not_supported])} not-supported"
    puts ""

    write_results(results, adapter, index) if @output

    counts[:fail] > 0 || counts[:error] > 0 ? 1 : 0
  end

  private

  def select_tests(suite, index)
    if @profile
      [suite.tests_for_profile(@profile), "Profile #{@profile}"]
    elsif @class_filter
      [suite.tests_for_class(@class_filter), "Class #{@class_filter}"]
    else
      [suite.all_tests, "All tests"]
    end
  end

  def list_available(suite, index)
    puts ""
    puts Term.bold("  Adapters:")
    AdapterLoader.list.each { |name| puts "    #{Term.cyan(name)}" }

    puts ""
    puts Term.bold("  Profiles:")
    suite.profile_ids.each do |pid|
      p = index.profiles[pid]
      tc = (p["traceability"] || []).length
      at = (p["additional_tests"] || []).length
      puts "    #{Term.cyan(pid)} (#{tc} traceability classes, #{at} additional tests)"
    end

    puts ""
    puts Term.bold("  Conformance classes:")
    suite.class_ids.each do |cid|
      tests = suite.tests_for_class(cid)
      puts "    #{Term.cyan(cid)} (#{tests.length} tests)"
    end
    puts ""
  end

  def write_results(results, adapter, index)
    grouped = results.group_by { |r| infer_class(r["test"], index) }

    cc_results = []
    profile_results = []
    grouped.each do |(type, id), tests|
      key = type == :profile ? "profile" : "conformance_class"
      entry = {
        key => id,
        "status" => aggregate_status(tests),
        "test_results" => tests.map { |r|
          e = { "test" => r["test"], "result" => r["result"] }
          e["notes"] = r["notes"] if r["notes"]
          e
        }
      }
      if type == :profile
        profile_results << entry
      else
        cc_results << entry
      end
    end

    output = {
      "id" => "result:#{adapter.name.downcase.gsub(/[^a-z0-9]+/, '-')}",
      "implementation" => {
        "name" => adapter.name,
        "language" => adapter.language,
        "version" => adapter.version
      },
      "date" => Date.today.to_s,
      "tester" => "run-tests script",
      "verification" => "automated",
      "declared_conformance_classes" => adapter.respond_to?(:declared_conformance_classes) ? adapter.declared_conformance_classes : nil,
      "conformance_class_results" => cc_results,
      "profile_results" => profile_results.empty? ? nil : profile_results
    }.compact

    FileUtils.mkdir_p(File.dirname(@output))
    schema_ref = "# yaml-language-server: $schema=../schema/conformance-result.yaml"
    File.write(@output, "#{schema_ref}\n#{YAML.dump(output)}")
    puts Term.dim("  Results written to #{@output}")
  end

  def infer_class(test_id, index)
    class_id = index.class_for_test(test_id)
    return [:profile, class_id] if class_id&.start_with?("profile:")
    return [:conformance_class, class_id] if class_id

    [:conformance_class, "unknown"]
  end

  def aggregate_status(tests)
    statuses = tests.map { |r| r["result"] }.uniq
    case
    when statuses == ["pass"]                                        then "passed"
    when statuses.include?("fail") || statuses.include?("error")     then "failed"
    when statuses == ["not-supported"]                               then "not-supported"
    else                                                                  "partial"
    end
  end
end

options = {}
parser = OptionParser.new do |opts|
  opts.banner = "Usage: ruby run-tests [options]"

  opts.on("-a", "--adapter NAME", "Adapter to use (default: ruby-date). Use exec:CMD for external adapters") do |a|
    options[:adapter] = a
  end

  opts.on("-p", "--profile PROFILE", "Run tests for a specific profile") do |p|
    p = p.start_with?("profile:") ? p : "profile:#{p}"
    options[:profile] = p
  end

  opts.on("-c", "--class CLASS", "Run tests for a specific conformance class") do |c|
    c = c.start_with?("conf-class:") ? c : "conf-class:#{c}"
    options[:class_filter] = c
  end

  opts.on("-o", "--output FILE", "Write results to YAML file") do |f|
    options[:output] = f
  end

  opts.on("-l", "--list", "List available adapters, profiles, and classes") do
    options[:list] = true
  end

  opts.on("-v", "--verbose", "Show test descriptions") do
    options[:verbose] = true
  end

  opts.on("-q", "--quiet", "Only show summary") do
    options[:quiet] = true
  end

  opts.on("-h", "--help", "Show help") do
    puts opts
    exit 0
  end
end
parser.parse!

exit Runner.new(options).run
